# Supabase project URL and publishable key — sign-in (email and password only) goes through
# Supabase Auth. Both are public by design and ship to the browser; read once, in web/lib/env/client.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Venmo handle used for the settle-up deep link, leading "@" optional.
NEXT_PUBLIC_VENMO_HANDLE=@your-venmo-handle
