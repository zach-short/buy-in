# Backend API URL. Leave as localhost except for deployment.
NEXT_PUBLIC_API_URL=http://localhost:8080

# NextAuth secret (credentials-only auth today — see web/lib/auth.ts).
AUTH_SECRET=your-auth-secret-key-here

# Venmo handle used for the settle-up deep link, leading "@" optional.
NEXT_PUBLIC_VENMO_HANDLE=@your-venmo-handle
